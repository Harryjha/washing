generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id        String   @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  riders    User[]   @relation("RiderAssignedStores")
  orders    Order[]  @relation("StoreOrders")
  createdAt DateTime @default(now())
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  name       String
  role       Role     @default(CUSTOMER)
  phone      String?
  address    String?
  storeId    String?
  stores     Store[]  @relation("RiderAssignedStores")
  orders             Order[]  @relation("CustomerOrders")
  deliveries         Order[]  @relation("RiderOrders")
  deliveryTasks      Order[]  @relation("DeliveryRiderOrders")
  createdAt          DateTime @default(now())
}

enum Role {
  CUSTOMER
  RIDER
  ADMIN
  STORE_ADMIN
}

model Order {
  id               Int         @id @default(autoincrement())
  customerId       Int
  customer         User        @relation("CustomerOrders", fields: [customerId], references: [id])
  riderId          Int?
  rider            User?       @relation("RiderOrders", fields: [riderId], references: [id])
  deliveryRiderId  Int?
  deliveryRider    User?       @relation("DeliveryRiderOrders", fields: [deliveryRiderId], references: [id])
  storeId          String?
  store            Store?      @relation("StoreOrders", fields: [storeId], references: [id])
  status           OrderStatus @default(PENDING_PICKUP)
  totalAmount      Float       @default(0)
  serviceType      String?
  itemsDescription String
  pickupAddress    String
  pickupLatitude   Float?
  pickupLongitude  Float?
  pickupLandmark   String?
  pickupDate       DateTime?
  specialNote      String?
  verificationCode String?
  pickedUpAt       DateTime?
  receivedAtStoreAt DateTime?
  readyForDeliveryAt DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PENDING_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  RECEIVED_AT_STORE
  IN_WASHING
  IN_LAUNDRY
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

